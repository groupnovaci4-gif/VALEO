# ---------------------------------------------------------------------------
# VALEO — backend. Copier en `.env` et renseigner. NE JAMAIS COMMITTER `.env`.
# ---------------------------------------------------------------------------
# Ce fichier-ci est un MODÈLE : il ne contient aucune valeur réelle, et un test
# (`test_deploiement.py`) vérifie qu'il décrit bien TOUTES les variables que le
# code lit. Une variable ajoutée au code sans être décrite ici casse la suite.

# === Obligatoire, toujours =================================================
# Le serveur refuse de démarrer sans ces deux-là.
ADMIN_PASSWORD=
# Secret de signature des jetons VALEO (HS256). Générer une valeur longue et
# aléatoire : `openssl rand -hex 32`. La changer déconnecte tout le monde.
JWT_SECRET=

# === Base de données ========================================================
# `mongo` (défaut) ou `firestore`. Cf. invariant 29.
DATA_BACKEND=mongo

# Requis SI DATA_BACKEND=mongo. Inutiles sur Firestore.
MONGO_URL=mongodb://localhost:27017
DB_NAME=valeo

# Requis SI DATA_BACKEND=firestore, sauf sur Cloud Run où le compte de service
# est ambiant (détecté par K_SERVICE). UNE SEULE de ces trois suffit.
#   FIREBASE_SERVICE_ACCOUNT     le JSON du compte de service, sur une ligne
#   FIREBASE_SERVICE_ACCOUNT_FILE  son chemin sur disque
#   GOOGLE_APPLICATION_CREDENTIALS  la variable standard de Google
# ⚠️ Ce JSON est une clé privée : elle donne TOUS les droits sur le projet.
FIREBASE_SERVICE_ACCOUNT_FILE=
# FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=
# Nom de la base Firestore, si ce n'est pas celle par défaut.
FIRESTORE_DATABASE=(default)

# === Facultatif =============================================================
# Durée du jeton administrateur, en minutes (défaut 720).
JWT_EXPIRE_MINUTES=720
# Origines autorisées, séparées par des virgules. `*` par défaut : acceptable
# car le jeton voyage dans l'en-tête Authorization, jamais dans un cookie.
CORS_ORIGINS=*
# Nombre d'échecs avant verrouillage temporaire d'un identifiant (invariant 17).
LOGIN_MAX_FAILS=5
# Vérifier à chaque appel si la session Firebase a été révoquée (défaut : oui).
# La mettre à 0 économise un aller-retour vers Google, au prix d'une révocation
# qui n'est plus immédiate.
FIREBASE_CHECK_REVOKED=1
# Force les identifiants Google ambiants hors Cloud Run (GKE, VM).
FIREBASE_USE_ADC=
# Secondes accordées à la préparation de la base au démarrage (défaut 5).
# Cf. invariant 30 : sans borne, une base injoignable fait patienter 30 s à
# CHAQUE démarrage d'instance.
STARTUP_TIMEOUT_SECONDS=5

# === Bascule (phase 6) ======================================================
# À poser sur l'ANCIEN déploiement uniquement, avec l'adresse du nouveau.
# Le serveur annonce alors qu'il est hors service dans un en-tête, et les
# téléphones dont l'URL est figée au build le disent à leur utilisateur.
# Laisser VIDE tant qu'on n'a pas basculé. Cf. invariant 32.
BACKEND_DEPRECIE=
