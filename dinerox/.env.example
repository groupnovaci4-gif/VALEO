# ─────────────────────────────────────────────────────────────────────
# Variables PUBLIQUES de l'application (préfixe EXPO_PUBLIC_, intégrées au
# bundle). Copier en .env (développement), .env.staging, .env.production.
# Ne JAMAIS mettre de secret ici : les clés Firebase web sont des
# identifiants publics protégés par les règles de sécurité.
# Les secrets (clé d'API IA) vont dans Secret Manager :
#   firebase functions:secrets:set ANTHROPIC_API_KEY
# ─────────────────────────────────────────────────────────────────────

# development | staging | production (sélectionne aussi le bundle id)
APP_ENV=development

# Projet Firebase (Console Firebase › Paramètres du projet › Vos applications ›
# « DineroX app » (Web) › Configuration du SDK). Valeurs publiques, non secrètes.
# Valeurs du projet Firebase « dinerox-app », application web « DineroX app ».
# Un projet distinct par environnement est recommandé (staging, production).
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyACWUfcEnhj7Jq8t5LqXls_DrQZqVNXeFM
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=dinerox-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=dinerox-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=dinerox-app.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=653588987819
EXPO_PUBLIC_FIREBASE_APP_ID=1:653588987819:web:1e0d1cbcb91beca43d5cee

# Région des Cloud Functions (doit correspondre à setGlobalOptions)
EXPO_PUBLIC_FUNCTIONS_REGION=europe-west1

# Émulateurs locaux (développement) : IP de la machine qui exécute
# `firebase emulators:start` (laisser vide pour utiliser le vrai projet)
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# Connexion Google (Google Cloud › Identifiants OAuth). Vide = bouton masqué.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Menu « données de démonstration » hors __DEV__ (jamais en production)
EXPO_PUBLIC_ENABLE_DEMO=false

# Identifiant du projet EAS (notifications push, builds)
EAS_PROJECT_ID=
