rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════
// Règles de sécurité Firestore — LE SERVEUR DÉCIDE.
//
// Principes :
//  1. Isolation : un utilisateur ne lit/écrit que ses espaces (personnel ou
//     familles dont il est membre). Aucune donnée d'un autre utilisateur.
//  2. Rôles (miroir de src/core/permissions.ts) :
//       admin   — tout ; partner — données partagées ; child — limité.
//  3. Les membres d'un espace ne changent QUE via Cloud Functions.
//  4. L'abonnement n'est écrit QUE par le serveur.
//  5. Conflits : une mise à jour plus ancienne (updatedAt) que la version
//     stockée est refusée — « le plus récent gagne », arbitré ici.
//  6. Pas de suppression physique côté client : suppression logique
//     (deleted: true), pour que la suppression se synchronise hors-ligne.
//  7. Refus par défaut : toute collection non listée est inaccessible.
// ═══════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isPlatformAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isInt(v) { return v is int; }
    function isISODate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function optString(data, k, max) { return !(k in data) || data[k] == null || (data[k] is string && data[k].size() <= max); }
    function optInt(data, k) { return !(k in data) || data[k] == null || data[k] is int; }
    // Argent disponible v2 (docs/argent-disponible.md) : champs FACULTATIFS (absents ou null acceptés).
    function optISODate(data, k) { return !(k in data) || data[k] == null || isISODate(data[k]); }
    function optBool(data, k) { return !(k in data) || data[k] == null || data[k] is bool; }
    function optIn(data, k, values) { return !(k in data) || data[k] == null || data[k] in values; }
    function optNonNegInt(data, k) { return !(k in data) || data[k] == null || (data[k] is int && data[k] >= 0); }

    // ─── Profil utilisateur ──────────────────────────────────────────
    match /users/{userId} {
      function validProfile(d) {
        return d.uid == userId
          && d.firstName is string && d.firstName.size() <= 80
          && d.currency is string && d.currency.size() == 3
          && d.language in ['fr', 'en']
          && d.keys().size() <= 30;
      }
      allow read: if signedIn() && me() == userId;
      // À la création, l'abonnement est forcément « gratuit ».
      allow create: if signedIn() && me() == userId && validProfile(request.resource.data)
        && request.resource.data.subscription.plan == 'free'
        && request.resource.data.subscription.status == 'active'
        && request.resource.data.subscription.provider == 'none'
        // Parrainage, droits offerts et marqueur « origine déjà comptée » (étape 5) :
        // écrits par les Cloud Functions seulement.
        && !request.resource.data.keys().hasAny(['referredBy', 'referralProgress', 'grants', 'originCounted']);
      // Ensuite, le client ne peut jamais toucher à l'abonnement, à l'identité,
      // au parrainage (parrain, progression) ni aux droits offerts (« Plus offert »).
      allow update: if signedIn() && me() == userId && validProfile(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription', 'uid', 'createdAt', 'referredBy', 'referralProgress', 'grants', 'originCounted']);
      allow delete: if false; // Cloud Function deleteAccount

      // Parrainage : mon code et mes compteurs (`referral/state`), le statut de
      // chacun de mes filleuls (`referrals/{uid}`, sans aucun montant).
      // Lecture par le seul propriétaire ; écriture par les Cloud Functions seulement.
      match /referral/{docId} {
        allow read: if signedIn() && me() == userId;
        allow write: if false;
      }
      match /referrals/{filleulId} {
        allow read: if signedIn() && me() == userId;
        allow write: if false;
      }

      // Jetons push de l'utilisateur.
      match /devices/{deviceId} {
        allow read, delete: if signedIn() && me() == userId;
        allow create, update: if signedIn() && me() == userId
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string && request.resource.data.token.size() < 300;
      }

      // Coach : historique PERSONNEL des événements déjà présentés (déduplication
      // entre appareils). Aucun montant ni texte : type, gravité, période seulement.
      match /coachEvents/{eventId} {
        allow read, delete: if signedIn() && me() == userId;
        allow create, update: if signedIn() && me() == userId
          && eventId.size() <= 160
          && request.resource.data.keys().hasOnly(['kind', 'severity', 'period', 'spaceId', 'deliveredAt'])
          && request.resource.data.kind is string && request.resource.data.kind.size() <= 60
          && request.resource.data.severity in ['info', 'advice', 'warning', 'critical', 'celebration']
          && request.resource.data.period is string && request.resource.data.period.size() <= 10
          && request.resource.data.spaceId is string && request.resource.data.spaceId.size() <= 128
          && request.resource.data.deliveredAt is int;
      }

      // Récompenses PERSONNELLES : identifiant `${récompense}_${période}`, création
      // seule (jamais deux fois la même, jamais modifiée), visibles du seul propriétaire.
      match /rewards/{rewardKey} {
        allow read, delete: if signedIn() && me() == userId;
        allow create: if signedIn() && me() == userId
          && rewardKey.size() <= 160
          && request.resource.data.keys().hasOnly(['rewardId', 'period', 'earnedAt', 'spaceId'])
          && request.resource.data.rewardId is string && request.resource.data.rewardId.size() <= 40
          && request.resource.data.period is string && request.resource.data.period.size() <= 128
          && rewardKey == request.resource.data.rewardId + '_' + request.resource.data.period
          && request.resource.data.earnedAt is int
          && request.resource.data.spaceId is string && request.resource.data.spaceId.size() <= 128;
        allow update: if false;
      }
    }

    // Abonnements vérifiés côté serveur (reçus, fournisseurs).
    match /subscriptions/{userId} {
      allow read: if signedIn() && me() == userId;
      allow write: if false;
    }

    // ─── Espaces ────────────────────────────────────────────────────
    match /spaces/{spaceId} {
      function spaceData() { return get(/databases/$(database)/documents/spaces/$(spaceId)).data; }
      // Espace personnel : id = uid, aucun get() nécessaire.
      function roleOf() {
        return spaceId == me() ? 'admin' : spaceData().members.get(me(), null);
      }
      function isMember() { return signedIn() && roleOf() in ['admin', 'partner', 'child']; }

      // Son propre espace personnel est lisible même s'il n'existe pas encore
      // (sinon la vérification « existe-t-il ? » de la première connexion échoue).
      allow read: if signedIn() && (spaceId == me() || me() in resource.data.memberIds);
      // Création : uniquement un espace dont on est le SEUL membre, administrateur.
      allow create: if signedIn()
        && request.resource.data.ownerId == me()
        // Personnel : id = uid du créateur. Famille : id préfixé « fam_ » (jamais un uid),
        // sinon un tiers pourrait occuper le chemin d'un espace personnel avant sa création.
        && ((request.resource.data.kind == 'personal' && spaceId == me())
            || (request.resource.data.kind == 'family' && spaceId.matches('^fam_[A-Za-z0-9]+$')))
        && request.resource.data.members.keys().hasOnly([me()])
        && request.resource.data.members[me()] == 'admin'
        && request.resource.data.memberIds == [me()]
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.currency is string && request.resource.data.currency.size() == 3;
      // Un admin peut renommer l'espace ou changer sa devise — rien d'autre.
      allow update: if signedIn() && resource.data.members.get(me(), null) == 'admin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'currency', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80;
      allow delete: if false;

      // ─── Données financières de l'espace ──────────────────────────
      match /{col}/{docId} {
        function knownCollection() {
          return col in ['accounts', 'categories', 'transactions', 'recurring', 'envelopes', 'budgets',
                         'goals', 'goalContributions', 'debts', 'debtPayments', 'assets',
                         // 1.7 : carnet de tontines (suivi seulement, aucun argent détenu).
                         'tontines', 'tontineEntries'];
        }
        function canRead() {
          let r = roleOf();
          return r in ['admin', 'partner']
            || (r == 'child' && col in ['transactions', 'categories', 'envelopes', 'budgets', 'goals', 'goalContributions', 'accounts']);
        }
        // Champs communs imposés à toute écriture.
        function validBase(d) {
          return d.id == docId
            && isInt(d.updatedAt) && isInt(d.createdAt)
            && d.createdBy is string
            && d.syncedAt == request.time
            && (!('deleted' in d) || d.deleted is bool)
            // Marqueur réservé au back-office (Admin SDK) : jamais écrit par un client.
            && !('adminDeleted' in d)
            && d.keys().size() <= 40;
        }
        function validTransaction(d) {
          // 1.8 : `adjustment` = ajustement de solde (sens obligatoire), ni revenu ni dépense.
          return d.type in ['income', 'expense', 'transfer', 'adjustment']
            && (d.type != 'adjustment' || (d.get('direction', null) in ['in', 'out']))
            && isInt(d.amount) && d.amount > 0 && d.amount < 1000000000000000
            && d.currency is string && d.currency.size() == 3
            && isISODate(d.date)
            && d.accountId is string
            && (d.type != 'transfer' || (d.toAccountId is string && d.toAccountId != d.accountId))
            && optInt(d, 'toAmount')
            && optString(d, 'payee', 120) && optString(d, 'note', 1000) && optString(d, 'receiptUrl', 2000)
            // Argent disponible v2 : motif d'un ajustement (§3.2), opération liée — frais, intérêts (§3.4, §5.5).
            && optString(d, 'reason', 200) && optString(d, 'linkedTransactionId', 128)
            && sameCurrencyAmount(d);
        }
        // §3.4 — en même devise, le montant reçu est le montant envoyé : un `toAmount` DIFFÉRENT
        // est refusé (un ancien `toAmount` égal au montant reste accepté, pour pouvoir le modifier
        // ou le supprimer). Compte destinataire inconnu à cet instant : rien à comparer.
        function sameCurrencyAmount(d) {
          return d.type != 'transfer' || d.get('toAmount', null) == null || d.toAmount == d.amount
            || !existsAfter(/databases/$(database)/documents/spaces/$(spaceId)/accounts/$(d.toAccountId))
            || getAfter(/databases/$(database)/documents/spaces/$(spaceId)/accounts/$(d.toAccountId)).data.currency != d.currency;
        }
        // Un enfant fait un apport à une réserve familiale, il ne l'utilise jamais
        // (contribution négative refusée sur une réserve ; miroir de canUseReserve).
        function childMayContribute(d) {
          return d.amount > 0
            || get(/databases/$(database)/documents/spaces/$(spaceId)/goals/$(d.goalId)).data.get('kind', 'goal') != 'reserve';
        }
        function validDoc(d) {
          return col == 'transactions' ? validTransaction(d)
            : col == 'accounts' ? (d.name is string && d.name.size() <= 80 && isInt(d.openingBalance) && d.currency is string && d.currency.size() == 3 && d.active is bool
                                // Argent disponible v2 : ouverture datée avec provenance (§3.1), découvert ≥ 0 (§3.5).
                                && optISODate(d, 'openingDate') && optString(d, 'openingNote', 200)
                                && optNonNegInt(d, 'overdraftLimit'))
            : col == 'goals' ? (d.name is string && d.name.size() <= 120 && isInt(d.targetAmount) && d.targetAmount >= 0 && isInt(d.initialAmount) && d.initialAmount >= 0
                                && d.status in ['active', 'paused', 'completed', 'abandoned', 'archived']
                                && d.priority in ['low', 'normal', 'high', 'urgent']
                                // 1.6 : réserve rechargeable (absent = objectif classique).
                                && (!('kind' in d) || d.kind == null || d.kind in ['goal', 'reserve'])
                                // Argent disponible v2 (§5.2) : montant initial « hors de mes comptes » et sa provenance.
                                && optIn(d, 'initialSource', ['outside']) && optString(d, 'initialNote', 200))
            : col == 'goalContributions' ? (d.goalId is string && isInt(d.amount) && d.amount != 0 && isISODate(d.date)
                                && optString(d, 'linkedTransactionId', 128))
            : col == 'envelopes' ? (d.name is string && d.name.size() <= 80 && isInt(d.monthlyBudget) && d.monthlyBudget >= 0)
            : col == 'debts' ? (d.direction in ['i_owe', 'owed_to_me'] && isInt(d.principal) && d.principal > 0 && d.counterparty is string && d.counterparty.size() <= 120
                                // Argent disponible v2 (§5.5) : clôture avec un reste — dette remise, créance abandonnée.
                                && optIn(d, 'closedReason', ['forgiven', 'written_off']) && optISODate(d, 'closedAt'))
            : col == 'debtPayments' ? (d.debtId is string && isInt(d.amount) && d.amount > 0 && isISODate(d.date)
                                // §5.5 : « Hors de mes comptes », choisi explicitement.
                                && optBool(d, 'offAccounts'))
            : col == 'assets' ? (d.name is string && d.name.size() <= 120 && isInt(d.value) && d.value >= 0)
            : col == 'recurring' ? (d.type in ['income', 'expense'] && isInt(d.amount) && d.amount > 0 && d.frequency in ['weekly', 'monthly', 'yearly'] && isISODate(d.startDate))
            : col == 'budgets' ? (d.month is string && d.month.matches('^[0-9]{4}-[0-9]{2}$') && d.id == d.month)
            : col == 'categories' ? (d.kind in ['income', 'expense'] && d.name is string && d.name.size() <= 60)
            : col == 'tontines' ? (d.type in ['rotating', 'collector', 'fixed_contribution'] && d.name is string && d.name.size() <= 120
                                && isInt(d.amountPerShare) && d.amountPerShare > 0
                                && d.sharesHeld is number && d.sharesHeld > 0 && d.sharesHeld <= 50
                                && d.frequency in ['daily', 'weekly', 'biweekly', 'monthly', 'custom']
                                && isISODate(d.startDate) && d.status in ['active', 'finished', 'paused']
                                && d.currency is string && d.currency.size() == 3
                                && optString(d, 'organizerName', 80) && optInt(d, 'membersCount') && optInt(d, 'potAmount')
                                // Argent disponible v2 (§5.4) : date de la clôture confirmée par la personne.
                                && optISODate(d, 'closedAt'))
            : col == 'tontineEntries' ? (d.tontineId is string && d.kind in ['contribution', 'payout', 'fee', 'penalty']
                                && isInt(d.period) && d.period > 0 && isInt(d.amount) && d.amount >= 0
                                && isISODate(d.date) && d.status in ['planned', 'done', 'late'])
            : false;
        }

        allow read: if knownCollection() && isMember() && canRead();

        allow create: if knownCollection() && isMember()
          && validBase(request.resource.data) && validDoc(request.resource.data)
          // Audit 2026-10 (F1) : à la création, l'auteur est toujours la personne connectée (tous les rôles).
          && request.resource.data.createdBy == me()
          && (
            roleOf() in ['admin', 'partner']
            // Enfant : ses propres dépenses et contributions uniquement.
            || (roleOf() == 'child'
                && request.resource.data.createdBy == me()
                && ((col == 'transactions' && request.resource.data.type == 'expense')
                    || (col == 'goalContributions' && childMayContribute(request.resource.data))))
          );

        allow update: if knownCollection() && isMember()
          // Supprimée par le back-office : plus aucune modification par un téléphone
          // (sinon une version hors ligne plus récente la ferait réapparaître).
          && resource.data.get('adminDeleted', false) != true
          && validBase(request.resource.data) && validDoc(request.resource.data)
          // L'auteur et la date de création sont immuables.
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          // Le plus récent gagne : une version plus ancienne est refusée.
          && request.resource.data.updatedAt >= resource.data.updatedAt
          && (
            roleOf() in ['admin', 'partner']
            || (roleOf() == 'child' && col == 'transactions' && resource.data.createdBy == me() && request.resource.data.type == 'expense')
          );

        allow delete: if false;
      }
    }

    // ─── Invitations familiales (écrites par les Cloud Functions) ────
    match /invites/{inviteId} {
      allow read: if signedIn() && (
        (request.auth.token.email != null && resource.data.email == request.auth.token.email.lower())
        || get(/databases/$(database)/documents/spaces/$(resource.data.spaceId)).data.members.get(me(), null) == 'admin'
      );
      allow write: if false;
    }

    // ─── Configuration publiée par les administrateurs ──────────────
    match /config/{doc}/items/{itemId} {
      allow read: if signedIn();
      allow write: if isPlatformAdmin();
    }
    // Interrupteur « connexion par numéro » (audit 23/10, C5) : lu par l'écran de bienvenue, AVANT
    // toute connexion. Ce seul document est public (un booléen) ; l'écriture reste à l'administrateur.
    match /config/app/items/phoneAuth {
      allow read: if true;
    }

    // ─── Parrainage : codes et empreintes d'appareils ───────────────
    // Serveur seul (Cloud Functions) : aucune lecture ni écriture client.
    match /referralCodes/{code} {
      allow read, write: if false;
    }
    match /referralDevices/{hash} {
      allow read, write: if false;
    }

    // ─── IA (docs/ia-comprend-tout.md §5) : jetons consommés par jour (nombres seulement) ─
    // Serveur seul (`understandPhrase`) : aucune lecture ni écriture client, même administrateur.
    match /aiUsage/{day} {
      allow read, write: if false;
    }

    // ─── Origine des inscriptions (étape 5) : compteurs anonymes par jour ─
    // Serveur seul (`recordSignupOrigin`) ; lus par `adminOriginStats`, déjà regroupés.
    match /originStats/{day} {
      allow read, write: if false;
    }

    // ─── Tontine partagée (croissance, étape 3) ─────────────────────
    // Lecture réservée aux membres ; AUCUNE écriture client : tout passe par la
    // Cloud Function `tontineGroup` (historique écrit avec l'état, en ajout seul).
    match /tontineGroups/{groupId} {
      function grp() { return get(/databases/$(database)/documents/tontineGroups/$(groupId)).data; }
      function isGroupMember() { return signedIn() && me() in grp().memberUids; }
      function isGroupManager() { return signedIn() && (grp().organizerUid == me() || grp().get('treasurerUid', null) == me()); }
      allow read: if signedIn() && me() in resource.data.memberUids;
      allow write: if false;
      // Déclarations et contestations : l'organisateur, le trésorier et la personne concernée.
      match /payments/{paymentId} {
        allow read: if isGroupManager() || (signedIn() && resource.data.uid == me());
        allow write: if false;
      }
      // Journal : ce qui est public pour tous les membres, le reste pour les gestionnaires et la personne concernée.
      match /history/{entryId} {
        allow read: if isGroupMember() && (resource.data.visibility == 'all' || isGroupManager() || resource.data.slotUid == me());
        allow write: if false;
      }
      // Demandes pour rejoindre : la personne qui demande et l'organisateur.
      match /requests/{requesterId} {
        allow read: if signedIn() && (requesterId == me() || grp().organizerUid == me());
        allow write: if false;
      }
    }
    match /tontineInvites/{code} {
      allow read, write: if false;
    }

    // ─── Statistiques anonymes (écriture seule, aucune lecture client) ─
    // Audit 2026-10 (M3) : seulement les événements et les propriétés de l'application
    // (toutes versions : src/services/analytics.ts › AnalyticsEvent, core/analyticsProps.ts ›
    // ALLOWED_PROPS), valeurs courtes (texte ≤ 40, nombre, oui/non) : ni texte libre ni donnée personnelle.
    match /analyticsEvents/{eventId} {
      function knownEvent(e) {
        return e in ['sign_up', 'onboarding_completed', 'first_expense', 'first_income', 'first_goal', 'first_envelope',
                     'ai_used', 'premium_viewed', 'premium_converted', 'unsubscribed', 'family_created', 'export_data',
                     'entry_created', 'voice_entry_corrected', 'voice_entry_failed', 'daily_reminder_opened', 'history_opened',
                     'mic_routed', 'voice_understood', 'referral_shared', 'referral_applied', 'share_clicked',
                     'tontine_created', 'tontine_group_invite_shared', 'tontine_group_joined', 'tontine_payment_declared',
                     'tontine_payment_confirmed', 'review_requested'];
      }
      function shortValue(p, k) {
        return !(k in p) || (p[k] is string && p[k].size() <= 40) || p[k] is number || p[k] is bool;
      }
      function validProps(p) {
        return p.keys().hasOnly(['method', 'plan', 'intent', 'source', 'step', 'kind', 'count', 'reason', 'to', 'context', 'channel', 'mode'])
          && shortValue(p, 'method') && shortValue(p, 'plan') && shortValue(p, 'intent') && shortValue(p, 'source')
          && shortValue(p, 'step') && shortValue(p, 'kind') && shortValue(p, 'count') && shortValue(p, 'reason')
          && shortValue(p, 'to') && shortValue(p, 'context') && shortValue(p, 'channel') && shortValue(p, 'mode');
      }
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['event', 'props', 'env', 'day', 'at'])
        && request.resource.data.event is string && knownEvent(request.resource.data.event)
        && request.resource.data.props is map && request.resource.data.props.size() <= 6
        && validProps(request.resource.data.props)
        && request.resource.data.env is string && request.resource.data.env.size() <= 40
        && isISODate(request.resource.data.day)
        && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }

    // ─── Back-office (docs/backoffice.md) ────────────────────────────
    // AUCUN accès client : tout passe par les Cloud Functions `bo…` (Admin SDK),
    // qui vérifient la permission à chaque appel. Ces collections tomberaient déjà
    // sous le refus par défaut : les écrire ici documente l'intention et la teste.
    match /boStaff/{id} { allow read, write: if false; }
    match /boRoles/{id} { allow read, write: if false; }
    match /boSessions/{id} { allow read, write: if false; }
    match /boAccess/{id} { allow read, write: if false; }
    match /boAudit/{id} { allow read, write: if false; }
    match /boAuditHead/{id} { allow read, write: if false; }
    match /boStats/{id} { allow read, write: if false; }
    match /boLoginGuard/{id} { allow read, write: if false; }
    match /boInvites/{id} { allow read, write: if false; }
    match /accountStatus/{uid} { allow read, write: if false; }

    // ─── Connexion par téléphone (docs/connexion-telephone) ──────────
    // Serveur seul (Cloud Functions `phone…`) : empreintes des codes reçus, empreintes des
    // codes secrets, limites et blocages par numéro, appareils vérifiés, index des numéros,
    // messages du fournisseur SIMULÉ (émulateurs). AUCUN accès client, même administrateur.
    match /phoneAuth/{id} { allow read, write: if false; }
    match /phoneSecrets/{uid} { allow read, write: if false; }
    match /phoneGuard/{id} { allow read, write: if false; }
    match /phoneDevices/{uid} { allow read, write: if false; }
    match /phoneIndex/{id} { allow read, write: if false; }
    match /phoneOutbox/{id} { allow read, write: if false; }

    // Tout le reste est refusé par défaut.
  }
}

